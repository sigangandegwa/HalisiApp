# Copy to backend/.env and fill in. Never commit .env.
# Loaded by backend/app/core/config.py (pydantic-settings). See docs/BACKEND.md section 3.

# --- App ---
APP_ENV=development                 # development | demo | production
DEMO_MODE=false                     # true = serve seeded fixtures, never hit external networks
API_KEY=change-me-long-random       # shared secret; Next.js server proxy sends it as X-Halisi-Key
CORS_ORIGINS=http://localhost:3000  # comma-separated, NEVER "*"
PUBLIC_CHECK_RATE_LIMIT=10/minute

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # server-only secret

# --- Engine (see docs/BREV_ENGINE_SETUP.md) ---
ENABLE_CLIP=false                   # true on Brev GPU; false on laptops = pHash/dHash only
ENGINE_DEVICE=auto                  # auto | cuda | cpu
CLIP_MODEL=clip-ViT-B-32
THREAT_THRESHOLD=70                 # composite score >= this creates a threat + alert
SUSPICIOUS_THRESHOLD=40

# --- LLM remediation via NVIDIA NIM (OpenAI-compatible) ---
LLM_ENABLED=true                    # false = deterministic templates only
LLM_BASE_URL=https://integrate.api.nvidia.com/v1   # self-hosted NIM on Brev: http://localhost:8000/v1
LLM_API_KEY=nvapi-xxxx
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_TIMEOUT_SECONDS=12

# --- In-app alerts (no Telegram/SMS; see docs/BACKEND.md section 8) ---
ALERT_DEDUP_HOURS=6                 # at most one alert per threat per window, unless the score rises

# --- Rate limits & proxy (docs/BACKEND.md section 11) ---
VERIFY_PAYMENT_RATE_LIMIT=20/minute
REPORT_RATE_LIMIT=5/minute
RATE_LIMIT_ENABLED=true
TRUST_FORWARDED_FOR=false           # true behind ngrok: trust X-Forwarded-For only from loopback peers

# --- Ingestion (docs/BACKEND.md section 7.2) ---
SCRAPER_ENABLED=true                # tier-2 OpenGraph fetch; always off in DEMO_MODE
FETCH_TIMEOUT_SECONDS=5
IMAGE_TIMEOUT_SECONDS=8
PROFILE_CACHE_SECONDS=600
# MEDIA_DIR=/path/to/media          # onboarded logos (default backend/media, served at /media)

# --- Takedown tracker (TSK-029, P2) ---
ENABLE_TAKEDOWN_TRACKER=false
TAKEDOWN_CHECK_HOURS=12
